<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9c97e90c-028b-4674-af57-55ef42a6dc47</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="SCRIPTS\AddNewSession.sql" />
    <None Remove="SCRIPTS\CardsPerStackView.sql" />
    <None Remove="SCRIPTS\init_card_create.sql" />
    <None Remove="SCRIPTS\init_create_db.sql" />
    <None Remove="SCRIPTS\init_stack_create.sql" />
    <None Remove="SCRIPTS\sessions.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SCRIPTS\AddNewSession.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SCRIPTS\CardsPerStackView.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SCRIPTS\init_card_create.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="SCRIPTS\init_create_db.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="SCRIPTS\init_stack_create.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="SCRIPTS\sessions.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.25.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
